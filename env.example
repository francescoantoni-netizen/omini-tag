# Copia questo file in ".env" (mai da caricare su GitHub: c'è già in .gitignore)
# e riempi i valori veri quando fai il deploy davvero.

# Stringa di connessione al database Postgres. In locale la crei con
# "createdb", su un host come Render/Railway te la dà il servizio di
# database Postgres una volta creato (di solito una variabile d'ambiente
# già pronta da incollare qui, es. DATABASE_URL).
DATABASE_URL=postgresql://ominitag:ominitag_dev_pw@localhost:5432/ominitag

# Chiave segreta per firmare i cookie di sessione: una stringa lunga e
# casuale, diversa per ogni ambiente (locale/produzione). In locale va bene
# qualunque cosa; in produzione generane una vera, ad es. con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambiami-in-una-stringa-lunga-e-casuale

# URL pubblico del sito, usato nei link delle email (verifica indirizzo,
# reimposta password). In locale va bene questo, in produzione mettici il
# dominio vero (es. https://acchiapparella.onrender.com).
APP_BASE_URL=http://localhost:3000

# ---- Invio email (verifica account, reset password) -----------------------
# Se lasci queste vuote, il server NON manda email vere: stampa il
# contenuto (incluso il link da cliccare) nei log del server, comodo per
# sviluppare/testare in locale senza configurare nulla. Per mandare email
# vere in produzione, scegli UNA delle due opzioni sotto.

# Opzione A — un provider con API tipo Resend (resend.com, piano gratuito
# generoso, 5 minuti per attivarlo):
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM="Acchiapparella <onboarding@resend.dev>"

# Opzione B — un server SMTP qualsiasi (es. Gmail con una "App Password",
# non la password vera del tuo account Google):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tuoindirizzo@gmail.com
# SMTP_PASS=la-tua-app-password
# MAIL_FROM="Acchiapparella <tuoindirizzo@gmail.com>"
